@model VeritabaniKatmani.SiteKayit
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Turnuva Yönetimi, Maç organizasyonu,Futbol Turnuvası">
    <meta name="author" content="Devcrud">
    <title>Turnuva Yönetimi</title>

    <!-- font icons -->
    <link rel="stylesheet" href="~/Content/vendors/themify-icons/css/themify-icons.css">

    <!-- Bootstrap + Creative Studio main styles -->
    <link rel="stylesheet" href="~/Content/assets/css/creative-studio.css">

</head>
<body data-spy="scroll" data-target=".navbar" data-offset="40" id="home">

    <!-- Page Navigation -->
    <nav class="navbar custom-navbar navbar-expand-lg navbar-dark" data-spy="affix" data-offset-top="20">
        <div class="container">
            <a class="navbar-brand" href="#">
                <img src="~/Content/assets/imgs/sitelogo.png" alt="Turnuva Yönetimi">
            </a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="#home">Giriş</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#about">Hakkında</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#service">Özellikler</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#contact">İletişim</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link btn btn-primary btn-sm ml-lg-3" href="/Login">Panele Giriş</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <!-- End Of Page Navigation -->
    <!-- Page Header -->
    <header class="header">
        <div class="overlay">
            <h3 class="subtitle">Ücretsiz denemek için kayıt ol</h3>
            <h5 class="title">Turnuva Yönetimi</h5>
            <div class="buttons text-center">
                <a href="#service" class="btn btn-primary rounded w-lg btn-lg my-1">Özellikler</a>
                <a href="#contact" class="btn btn-outline-light rounded w-lg btn-lg my-1">Ücretsiz Kayıt Ol</a>
            </div>
        </div>
    </header>
    <!-- End Of Page Header -->
    <!-- Box -->

    <div class="box text-center">
        <div class="box-item">
            <i class="ti-vector"></i>
            <h6 class="box-title">Takımları Tanımla</h6>
            <p>Turnuvada yer alan tüm takımları tanımlayın ve gerekli tüm evrakları burada saklayın.</p>
        </div>
        <div class="box-item">
            <i class="ti-filter"></i>
            <h6 class="box-title">Sporcuları Tanımla</h6>
            <p>Her takımın sporcularını tanımlayın ve evraklarını burada saklayın. Sporcuların turnuva istatistiklerine bir tıkla ulaşın.</p>
        </div>
        <div class="box-item">
            <i class="ti-mobile"></i>
            <h6 class="box-title">Görevlileri Tanımla</h6>
            <p>Maçlara görevli ve hakem atayın.</p>
        </div>
    </div>
    <!-- End of Box -->
    <!-- About Section -->
    <section id="about">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-5 col-lg-4">
                    <img src="~/Content/assets/imgs/about.jpg" alt="Turnuva Yönetimi Hakkında" class="w-100 img-thumbnail mb-3">
                </div>
                <div class="col-md-7 col-lg-8">
                    <h6 class="section-subtitle mb-0">Turnuva Yönetimi</h6>
                    <h6 class="section-title mb-3">Hakkında</h6>
                    <p>Futbol turnuva organizasyonlarını kolayca yönetebileceğiniz bu uygulamayı sizler için geliştirdik.</p>
                    <p>Takım,Sporcu, Görevli, Hakem tanımlamalarını yapıp bunların evraklarını bu panelden yönetebilirsiniz.</p>
                    <p>Maç, fikstür, istatistiksel veriler ve maç kurallarını buradan yönetebilirsiniz.</p>
                </div>
            </div>
        </div>
    </section>
    <!-- End of About Section -->
    <!-- About Section with bg -->
    <section class="has-bg-img py-md">
        <div class="container text-center">
            <h6 class="section-subtitle">Sizin İçin</h6>
            <h6 class="section-title mb-6">Herşeyi Kolaylaştırdık</h6>
            <div class="widget mb-4">
                <div class="widget-item">
                    <i class="ti-notepad"></i>
                    <h4>Takım</h4>
                </div>
                <div class="widget-item">
                    <i class="ti-layout"></i>
                    <h4>Sporcu</h4>
                </div>
                <div class="widget-item">
                    <i class="ti-filter"></i>
                    <h4>Hakem/Görevli</h4>
                </div>
                <div class="widget-item">
                    <i class="ti-thumb-up"></i>
                    <h4>Fikstür</h4>
                </div>
            </div>
        </div>
    </section>
    <!-- End Of About Sectoin -->
    <!-- Service Section -->
    <section id="service">
        <div class="container">
            <h6 class="section-subtitle text-center">Turnuva Yönetimi</h6>
            <h5 class="section-title text-center mb-6">Özellikler</h5>
            <div class="row">
                <div class="col-sm-4 col-md-3">
                    <div class="card mb-4">
                        <div class="card-body">
                            <h2 class="mb-4"><i class="ti-filter text-primary"></i></h2>
                            <h6 class="card-title">Fikstür</h6>
                            <p>Tüm fikstür tanımı ve çıktılarını buradan yönetebilirsin.</p>
                        </div>
                    </div>
                </div>
                <div class="col-sm-4 col-md-3">
                    <div class="card mb-4">
                        <div class="card-body">
                            <h2 class="mb-4"><i class="ti-paint-roller text-primary"></i></h2>
                            <h6 class="card-title">Maç</h6>
                            <p>Maç programlarını ve maç detaylarını buradan yapabilirsin.</p>
                        </div>
                    </div>
                </div>
                <div class="col-sm-4 col-md-3">
                    <div class="card mb-4">
                        <div class="card-body">
                            <h2 class="mb-4"><i class="ti-ruler-pencil text-primary"></i></h2>
                            <h6 class="card-title">Kurallar</h6>
                            <p>Turnuva kurallarını gir, çıktı al ve takımlara dağıt.</p>
                        </div>
                    </div>
                </div>
                <div class="col-sm-4 col-md-3">
                    <div class="card mb-4">
                        <div class="card-body">
                            <h2 class="mb-4"><i class="ti-layers text-primary"></i></h2>
                            <h6 class="card-title">Takımlar</h6>
                            <p>Tüm takım bilgilerini gir evrakları sakla ve istatistikleri al.</p>
                        </div>
                    </div>
                </div>
                <div class="col-sm-4 col-md-3">
                    <div class="card mb-4">
                        <div class="card-body">
                            <h2 class="mb-4"><i class="ti-bolt text-primary"></i></h2>
                            <h6 class="card-title">Sporcular</h6>
                            <p>Tüm sporcuları tanımla evrakları gir ve istatistikleri al.</p>
                        </div>
                    </div>
                </div>
                <div class="col-sm-4 col-md-3">
                    <div class="card mb-4">
                        <div class="card-body">
                            <h2 class="mb-4"><i class="ti-palette text-primary"></i></h2>
                            <h6 class="card-title">Hakemler</h6>
                            <p>Maç hakemlerini tanımla ve maçlara ata.</p>
                        </div>
                    </div>
                </div>
                <div class="col-sm-4 col-md-3">
                    <div class="card mb-4">
                        <div class="card-body">
                            <h2 class="mb-4"><i class="ti-stats-up text-primary"></i></h2>
                            <h6 class="card-title">Görevliler</h6>
                            <p>Saha görevlilerini tanımla ve maçlara ata</p>
                        </div>
                    </div>
                </div>
                <div class="col-sm-4 col-md-3">
                    <div class="card mb-4">
                        <div class="card-body">
                            <h2 class="mb-4"><i class="ti-location-arrow text-primary"></i></h2>
                            <h6 class="card-title">İstatistikler</h6>
                            <p>Gol kralı, asist kralı, sarı kartlar, kırmızı kartlar, centilmenlik tablosu, puan durumu hepsini gör ve çıktı al.</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>
    <!-- End of Service Section -->
    <!-- Contact Section -->
    <section id="contact">
        <div class="container">
            <div class="contact-card">
                <div class="infos">
                    <h6 class="section-subtitle">Turnuva Yönetim</h6>
                    <h6 class="section-title mb-4">Bize ulaşın</h6>

                    <div class="item">
                        <i class="ti-location-pin"></i>
                        <div class="">
                            <h5>Adres</h5>
                            <p> Bursa / Nilüfer</p>
                        </div>
                    </div>
                    <div class="item">
                        <i class="ti-mobile"></i>
                        <div>
                            <h5>Phone Number</h5>
                            <p>(555) 5555555</p>
                        </div>
                    </div>
                    <div class="item">
                        <i class="ti-email"></i>
                        <div class="mb-0">
                            <h5>Email Address</h5>
                            <p>info@turnuvayonetimi.com.tr</p>
                        </div>
                    </div>
                    <div class="item">
                        <i class="ti-world"></i>
                        <div class="mb-0">
                            <h5>www.turnuvayonetimi.com.tr</h5>
                            <p>info@turnuvayonetimi.com.tr</p>
                        </div>
                    </div>
                </div>



                <div class="form">
                    <h3 class="section-subtitle">Bilgileriniz incelendikten sonra mail adresine panel giriş bilgileri gönderilir.</h3>
                    <h6 class="section-title mb-4">Kayıt Ol</h6>



                    <div class="login-form">
                        @using (Html.BeginForm("Index", "Site", FormMethod.Post, new { @id = "login-form", @class = "form" }))
                        {
                            <div style="color:red">
                                @ViewBag.LoginError
                            </div>
                            <div class="form-group">
                                <label>@Html.DisplayFor(model => model.email, new { @class = "text-info" })</label>
                                @Html.TextBoxFor(m => m.email, new { @id = "username", @class = "form-control", @placeholder = "email..." })
                            </div>
                            <div class="form-group">
                                <label>@Html.DisplayFor(model => model.adsoyad, new { @class = "text-info" })</label>
                                @Html.TextBoxFor(m => m.adsoyad, new { @id = "adsoyad", @class = "form-control", @placeholder = "ad soyad..." })
                            </div>

                            <div class="form-group">
                                <label>@Html.DisplayFor(model => model.mesaj, new { @class = "text-info" })</label>
                                @Html.TextAreaFor(m => m.mesaj, new { @id = "mesaj", @class = "form-control", @placeholder = "mesaj...", rows = 5, columns = 40 })
                            </div>

                            <div class="form-group">
                                <button type="submit" class="btn btn-warning btn-flat m-b-30 m-t-30">Kayıt Ol</button>
                            </div>

                        }
                    </div>







                </div>
            </div>
        </div>
    </section>
    <!-- Contact Section -->

    <section class="has-bg-img py-0">
        <div class="container">
            <div class="footer">
                <div class="footer-lists">
                    <ul class="list">
                        <li class="list-head">
                            <h6 class="font-weight-bold">Hakkımızda</h6>
                        </li>
                        <li class="list-body">
                            <a href="#" class="logo">
                                <img src="~/Content/assets/imgs/sitelogo.png" alt="Turnuva Yönetimi">
                                <h6>Turnuva Yönetimi</h6>
                            </a>
                            <p>Futbol turnuva organizasyonlarını kolayca yönetebileceğiniz bu uygulamayı sizler için geliştirdik.</p>
                            <p class="mt-3">
                                Copyright
                                <script>document.write(new Date().getFullYear())</script> &copy; <a class="d-inline text-primary" href="http://www.turnuvayonetimi.com.tr">TurnuvaYönetimi</a>
                            </p>
                        </li>
                    </ul>
                    <ul class="list">
                        <li class="list-head">
                            <h6 class="font-weight-bold">Erişim</h6>
                        </li>
                        <li class="list-body">
                            <div class="row">
                                <div class="col">
                                    <a href="#about">Hakkımızda</a>
                                    <a href="#service">Özellikler</a>
                                </div>
                                <div class="col">
                                    <a href="#">Faq</a>
                                    <a href="#">Privacy Policy</a>
                                </div>
                            </div>
                        </li>
                    </ul>
                    <ul class="list">
                        <li class="list-head">
                            <h6 class="font-weight-bold">İletişim Bilgileri</h6>
                        </li>
                        <li class="list-body">
                            <p>Turnuva Yönetimini şimdi ücretsiz kullan.</p>
                            <p><i class="ti-location-pin"></i> Nilüfer/ Bursa</p>
                            <p><i class="ti-email"></i>  info@turnuvayonetimi.com</p>
                            <div class="social-links">
                                <a href="javascript:void(0)" class="link"><i class="ti-facebook"></i></a>
                                <a href="javascript:void(0)" class="link"><i class="ti-twitter-alt"></i></a>
                                <a href="javascript:void(0)" class="link"><i class="ti-google"></i></a>
                                <a href="javascript:void(0)" class="link"><i class="ti-pinterest-alt"></i></a>
                                <a href="javascript:void(0)" class="link"><i class="ti-instagram"></i></a>
                                <a href="javascript:void(0)" class="link"><i class="ti-rss"></i></a>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- core  -->
    <script src="~/Content/vendors/jquery/jquery-3.4.1.js"></script>
    <script src="~/Content/vendors/bootstrap/bootstrap.bundle.js"></script>

    <!-- bootstrap affix -->
    <script src="~/Content/vendors/bootstrap.affix.js"></script>
    <!-- Creative Studio js -->
    <script src="~/Content/assets/js/creative-studio.js"></script>

</body>
</html>
